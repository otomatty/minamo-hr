{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minamo-hr",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // React SPA (Vite build) を Workers Static Assets で配信し、/api/* だけ Worker が処理する
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // ID を書かずにおくと、初回の `wrangler deploy` で D1 / KV / R2 が自動作成されます
  // (Automatic resource provisioning)。既存リソースを使う場合は ID を追記してください。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minamo-hr",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "SESSIONS" }],
  "r2_buckets": [{ "binding": "FILES" }],

  // 毎日 0:05 (JST) に有休の自動付与・在籍ステータス更新を実行
  "triggers": { "crons": ["5 15 * * *"] },

  "vars": {
    "APP_TIMEZONE_OFFSET_MINUTES": "540"
  }
}
